# Database
DATABASE_URL="postgresql://cobyshelton@localhost:5432/tasks_app?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4100
CORS_ORIGIN="http://localhost:5173"

# Web Push (generate a pair with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Minimum gap between list-activity notifications per user, per list (ms)
NOTIFY_THROTTLE_MS=300000
